{
  "name": "taiwan-guidebook",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" && npm run -s test:py",
    "test:core": "node --test \"tests/core/*.test.js\"",
    "test:tasks": "node --test \"tests/tasks/*.test.js\"",
    "agy": "node .claude/skills/delegate-and-gate/scripts/agy-task.mjs",
    "build": "uv run --no-project --with \"jsonschema>=4.20,<5\" --python 3.12 python scripts/build_dataset.py",
    "test:py": "uv run --no-project --python 3.12 python -m unittest discover -s tests/py"
  }
}
